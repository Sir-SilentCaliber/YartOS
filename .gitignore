# ---- build artifacts (regenerated by `make`) ----
build/
iso_root/
yart.iso
yart-disk.img
serial.log
limine/

# ---- local test screenshots / scratch ----
desktop*.png
with_app.png
stable.png
probe.png
fixed_max.png
screenshot.png
*.ppm
*.png
*.wav
runlogs/

# ---- EXCEPTIONS: PNGs that are BUILD INPUTS (tracked source assets) ----
!kora/cursors/*.png

# ---- editor / OS cruft ----
*.swp
*~
.DS_Store

# ---- generated at build time (tracked in the original repo, removed for
#      portability - `make iso` regenerates all of these) ----

# every /bin binary (init, wm, nyra, files, media, camera, viewer, apk,
# test_*, dynhello, tlsdemo, ifuncdemo, copydemo, ...)
initrd_root/bin/

# all built shared objects (ld-yart.so, libgreet/libifunc/libcopy/libtls.so)
initrd_root/lib/*.so

# *.ypkg package archives
initrd_root/repo/

# desktop-entry dir seed (.keep)
initrd_root/usr/

initrd_root/etc/motd
initrd_root/etc/yart.conf
initrd_root/etc/wallpaper.bmp
initrd_root/home/yart/cursor.conf
initrd_root/YartOS/
kora/wallpapers/*.png

# ---- NOT ignored: initrd_root/lib/firmware/*.bin are TRACKED runtime
#      blobs (stand-in firmware + generated PHY tables) so the OS is
#      self-contained for real hardware without the Linux source tree ----
